{
  "name": "@tracelens/sdk",
  "version": "0.1.0",
  "description": "Zero-dependency instrumentation SDK for LLM & Agent observability",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
